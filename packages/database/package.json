{
  "name": "@dwar/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --env-file=../../.env dist/migrate.js",
    "seed": "node --env-file=../../.env dist/seed.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "@dwar/game-config": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
